          {
            "group": "Integrations",
            "pages": [
              {
                "group": "Version Control",
                "pages": [
                  "integrations/git"
                ]
              },
              {
                "group": "Backend Services",
                "pages": [
                  "integrations/supabase"
                ]
              },
              {
                "group": "Deployment Platforms",
                "pages": [
                  "integrations/deployments",
                  "integrations/netlify",
                  "integrations/vercel"
                ]
              }
            ]
          },
          {
            "group": "MCP Integration",
            "pages": [
              "mcp/mcp-overview"
            ]
          }
